{
  "name": "english-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "wrangler dev --port 8788",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "secrets:init": "node scripts/gen-secrets.mjs",
    "db:migrate:local": "wrangler d1 migrations apply english-app --local",
    "db:migrate:remote": "wrangler d1 migrations apply english-app --remote"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.0.0"
  }
}
